PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
PUBLIC_BASE_URL=https://your-render-service.onrender.com

# Set a long random secret. Keep it private and never commit your real .env file.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# SMS invitations use Hubtel Programmable SMS. Create credentials in your Hubtel account.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Sender IDs are subject to approval. Hubtel documentation limits sender IDs to 11 characters.
# Use a short approved name such as SIMGLO, not the full "Simglo Dataplus" brand name.
HUBTEL_SENDER_ID=SIMGLO
# Approximate planning rate only; check Hubtel for the actual selected gateway charge.
HUBTEL_ESTIMATED_COST_PER_SMS_GHS=0.033
HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send
# Optional: replace this when the real agent registration page is built and deployed.
AGENT_REGISTRATION_URL=https://your-render-service.onrender.com/#agents

# Add only after choosing a real data supplier and receiving its API documentation/credentials.
SUPPLIER_BASE_URL=
SUPPLIER_API_KEY=

# Paystack secret key belongs on the server only. Never put it in browser code.
PAYSTACK_SECRET_KEY=
